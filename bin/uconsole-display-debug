#!/bin/sh
# Collect display evidence without changing monitor, compositor, or wallpaper state.

set -u
umask 077
export LC_ALL=C

usage() {
    cat <<'EOF'
Usage: uconsole-display-debug [label]

Creates a timestamped report under ~/display-debug. The optional label is
useful for comparisons, for example: baseline, xorg-both, hypr-static.

This command is diagnostic only. It does not change outputs or configuration.
EOF
}

case "${1:-}" in
    -h|--help)
        usage
        exit 0
        ;;
esac

label=$(printf '%s' "${1:-snapshot}" | tr -cs 'A-Za-z0-9._-' '_')
timestamp=$(date '+%Y%m%d-%H%M%S')
output_dir=${UCONSOLE_DISPLAY_DEBUG_DIR:-"$HOME/display-debug"}
output_file="$output_dir/$timestamp-$label.log"

mkdir -p "$output_dir"

section() {
    printf '\n===== %s =====\n' "$1"
}

run() {
    printf '\n$'
    for argument in "$@"; do
        printf ' %s' "$argument"
    done
    printf '\n'
    "$@" 2>&1
    status=$?
    [ "$status" -eq 0 ] || printf '[exit=%s]\n' "$status"
    return 0
}

command_if_available() {
    command_name=$1
    shift
    if command -v "$command_name" >/dev/null 2>&1; then
        run "$command_name" "$@"
    else
        printf '\n[not installed: %s]\n' "$command_name"
    fi
}

{
    section "CAPTURE"
    printf 'label=%s\n' "$label"
    printf 'timestamp=%s\n' "$(date --iso-8601=seconds)"
    printf 'user=%s\n' "$(id -un)"
    printf 'session_type=%s\n' "${XDG_SESSION_TYPE:-unset}"
    printf 'desktop=%s\n' "${XDG_CURRENT_DESKTOP:-unset}"
    printf 'display=%s\n' "${DISPLAY:-unset}"
    printf 'wayland_display=%s\n' "${WAYLAND_DISPLAY:-unset}"
    run uname -a
    command_if_available uptime
    command_if_available free -h

    section "DRM CONNECTORS"
    if [ -d /dev/dri ]; then
        run ls -l /dev/dri
    fi
    if [ -d /dev/dri/by-path ]; then
        run ls -l /dev/dri/by-path
    fi

    connector_found=0
    for status_file in /sys/class/drm/card*-*/status; do
        [ -e "$status_file" ] || continue
        connector_found=1
        connector_dir=${status_file%/status}
        connector_name=${connector_dir##*/}
        printf '\n[%s]\n' "$connector_name"
        for attribute in status enabled dpms mode; do
            if [ -r "$connector_dir/$attribute" ]; then
                printf '%s=' "$attribute"
                cat "$connector_dir/$attribute" 2>/dev/null || printf 'unreadable\n'
            fi
        done
        if [ -s "$connector_dir/modes" ]; then
            printf 'modes:\n'
            sed 's/^/  /' "$connector_dir/modes"
        fi
    done
    [ "$connector_found" -eq 1 ] || printf 'No DRM connectors found.\n'

    if command -v kmsprint >/dev/null 2>&1; then
        section "KMSPRINT"
        card_found=0
        for card in /dev/dri/card*; do
            [ -e "$card" ] || continue
            card_found=1
            run kmsprint --device="$card" -m
        done
        [ "$card_found" -eq 1 ] || printf 'No accessible DRM card nodes in this execution context.\n'
    fi

    section "HYPRLAND"
    if command -v Hyprland >/dev/null 2>&1; then
        run /usr/bin/Hyprland --version
    fi
    if command -v hyprctl >/dev/null 2>&1 && [ -n "${HYPRLAND_INSTANCE_SIGNATURE:-}" ]; then
        run hyprctl version
        run hyprctl monitors all
        run hyprctl clients
        run hyprctl configerrors
        hyprland_pid=$(pgrep -o -x Hyprland 2>/dev/null || true)
        if [ -n "$hyprland_pid" ] && [ -r "/proc/$hyprland_pid/maps" ]; then
            printf '\n[loaded Aquamarine library]\n'
            grep 'libaquamarine' "/proc/$hyprland_pid/maps" | awk '{print $6}' | sort -u || true
        fi
    else
        printf 'No reachable Hyprland session in this shell.\n'
    fi
    runtime_dir=${XDG_RUNTIME_DIR:-"/run/user/$(id -u)"}
    wrapper_log="$runtime_dir/uconsole-hyprland-wrapper.log"
    if [ -r "$wrapper_log" ]; then
        printf '\n[%s]\n' "$wrapper_log"
        cat "$wrapper_log"
    fi
    mgpu_log="$runtime_dir/uconsole-hyprland-mgpu.log"
    if [ -r "$mgpu_log" ]; then
        printf '\n[%s]\n' "$mgpu_log"
        cat "$mgpu_log"
    fi

    section "XORG XRANDR"
    if command -v xrandr >/dev/null 2>&1 \
        && [ "${XDG_SESSION_TYPE:-}" = x11 ] \
        && [ -n "${DISPLAY:-}" ]; then
        run xrandr --listproviders
        run xrandr --query
        run xrandr --listmonitors
    else
        printf 'No reachable Xorg display in this shell.\n'
    fi
    xorg_log="$HOME/.local/share/xorg/Xorg.0.log"
    if [ -r "$xorg_log" ]; then
        printf '\n[Xorg display-related messages]\n'
        grep -Ei 'drm|dsi|hdmi|modeset|randr|frame buffer|pixmap sharing|aiglx|dri' "$xorg_log" | tail -n 250
    fi

    section "WALLPAPER"
    wallpaper_state="$HOME/.cache/uconsole/wallpaper"
    if [ -r "$wallpaper_state" ]; then
        current_wallpaper=$(cat "$wallpaper_state" 2>/dev/null || true)
        printf 'configured_wallpaper=%s\n' "$current_wallpaper"
        if [ -n "$current_wallpaper" ] && [ -e "$current_wallpaper" ]; then
            run file "$current_wallpaper"
            run stat -c '%n | %s bytes | %y' "$current_wallpaper"
        fi
    fi
    command_if_available swww query
    command_if_available pgrep -af 'swww|swaybg|hyprpaper|mpvpaper'
    printf '\n[process CPU average since each process started; not instantaneous]\n'
    ps -eo pid,ppid,pcpu,pmem,etime,stat,cmd | grep -E '[s]www|[s]waybg|[h]yprpaper|[m]pvpaper' || true

    section "LIVE COMPOSITOR AND WALLPAPER CPU"
    sample_pids=
    for process_name in Hyprland swww-daemon swaybg hyprpaper mpvpaper; do
        process_pids=$(pgrep -d, -x "$process_name" 2>/dev/null || true)
        [ -n "$process_pids" ] || continue
        if [ -n "$sample_pids" ]; then
            sample_pids="$sample_pids,$process_pids"
        else
            sample_pids=$process_pids
        fi
    done
    if [ -n "$sample_pids" ] && command -v top >/dev/null 2>&1; then
        printf 'The first top sample can be cumulative; use the following samples as live CPU.\n'
        run top -b -d 1 -n 5 -p "$sample_pids"
    else
        printf 'No compositor or wallpaper process available for live sampling.\n'
    fi
    wallpaper_log="$HOME/.cache/uconsole/wallpaper.log"
    if [ -r "$wallpaper_log" ]; then
        printf '\n[wallpaper log tail]\n'
        tail -n 80 "$wallpaper_log"
    fi

    section "PRESSURE"
    for pressure_file in /proc/pressure/cpu /proc/pressure/io /proc/pressure/memory; do
        if [ -r "$pressure_file" ]; then
            printf '\n[%s]\n' "$pressure_file"
            cat "$pressure_file"
        fi
    done
    command_if_available vmstat 1 3

    section "PACKAGES"
    if command -v dpkg-query >/dev/null 2>&1; then
        dpkg-query -W -f='${binary:Package}\t${Version}\n' 2>/dev/null \
            | grep -E '^(hyprland|libaquamarine|libdrm|libegl|libgbm|xserver-xorg-core)' \
            || true
    fi

    section "KERNEL DISPLAY MESSAGES"
    if command -v journalctl >/dev/null 2>&1; then
        journalctl -k -b --no-pager 2>&1 \
            | grep -Ei 'drm|hdmi|dsi|vc4|v3d|rp1|edid|framebuffer' \
            | tail -n 300 \
            || true
    fi
} >"$output_file" 2>&1

printf '%s\n' "$output_file"
