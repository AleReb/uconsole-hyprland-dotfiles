#!/bin/sh
set -eu

runtime_dir=${XDG_RUNTIME_DIR:-/run/user/$(id -u)}
log_file="$runtime_dir/uconsole-display-autoswitch.log"
lock_dir="$runtime_dir/uconsole-display-autoswitch.lock"

if ! mkdir "$lock_dir" 2>/dev/null; then
    exit 0
fi
cleanup() {
    rmdir "$lock_dir" 2>/dev/null || true
}
trap cleanup EXIT
trap 'exit 0' INT TERM

log() {
    printf '%s %s\n' "$(date '+%F %T')" "$*" >>"$log_file"
}

maybe_legacy_switch() {
    status=$(/home/uconsole/.local/bin/uconsole-display-switch status 2>/dev/null || true)
    current=$(printf '%s\n' "$status" | sed -n 's/^CURRENT_MODE=//p' | tail -n 1)
    target=$(printf '%s\n' "$status" | sed -n 's/^TARGET_MODE=//p' | tail -n 1)

    [ -n "$current" ] || current=unknown
    [ -n "$target" ] || target=unknown

    if [ "$current" != "$target" ] && [ "$target" != unknown ]; then
        log "legacy-switch current=$current target=$target"
        /home/uconsole/.local/bin/uconsole-display-switch switch
        exit 0
    fi
}

hdmi_state() {
    for status in /sys/class/drm/card*-HDMI-A-*/status; do
        [ -r "$status" ] || continue
        if [ "$(cat "$status" 2>/dev/null)" = connected ]; then
            connector=${status%/status}
            connector=${connector##*/}
            printf 'connected:%s\n' "${connector#card*-}"
            return 0
        fi
    done
    printf 'disconnected\n'
}

refresh_waybar() {
    helper=/home/uconsole/.local/bin/uconsole-waybar-restart
    sleep 1
    if pkill -USR2 -x waybar >/dev/null 2>&1; then
        log "waybar-reloaded"
        return 0
    fi

    [ -x "$helper" ] || {
        log "waybar-refresh-skipped helper-missing"
        return 0
    }

    if "$helper"; then
        log "waybar-restarted"
    else
        log "waybar-restart-failed"
    fi
}

restore_internal_wallpaper() {
    # Kanshi needs a moment to remove HDMI and activate the single-DSI profile.
    attempt=1
    while [ "$attempt" -le 8 ]; do
        monitors=$(hyprctl monitors 2>/dev/null || true)
        if printf '%s\n' "$monitors" | grep -q '^Monitor DSI-' && ! printf '%s\n' "$monitors" | grep -q '^Monitor HDMI-'; then
            if /home/uconsole/.local/bin/uconsole-wallpaper apply; then
                log "wallpaper-restored internal attempt=$attempt"
                return 0
            fi
            log "wallpaper-restore-failed internal attempt=$attempt"
        fi
        sleep 1
        attempt=$((attempt + 1))
    done

    log "wallpaper-restore-timeout internal"
    return 1
}

last_state=$(hdmi_state)
log "started mode=hotplug state=$last_state"

while :; do
    maybe_legacy_switch
    state=$(hdmi_state)
    if [ "$state" != "$last_state" ]; then
        log "hotplug old=$last_state new=$state"
        case "$state" in
            connected:*)
                output=${state#connected:}
                if /home/uconsole/.local/bin/uconsole-wallpaper output "$output"; then
                    log "wallpaper-restored output=$output"
                else
                    log "wallpaper-restore-failed output=$output"
                fi
                ;;
            disconnected)
                if restore_internal_wallpaper; then
                    :
                else
                    log "wallpaper-restore-failed after-hdmi-disconnect"
                fi
                ;;
        esac
        refresh_waybar
        last_state=$state
    fi
    sleep 2
done
