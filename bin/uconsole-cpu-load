#!/bin/sh
state="${XDG_CACHE_HOME:-$HOME/.cache}/uconsole/cpu.stat"
mkdir -p "$(dirname "$state")"

read -r _ user nice system idle iowait irq softirq steal _ < /proc/stat
idle_all=$((idle + iowait))
non_idle=$((user + nice + system + irq + softirq + steal))
total=$((idle_all + non_idle))

if [ -r "$state" ]; then
    read -r prev_total prev_idle < "$state" || true
else
    prev_total=$total
    prev_idle=$idle_all
fi

printf '%s %s\n' "$total" "$idle_all" > "$state"

diff_total=$((total - prev_total))
diff_idle=$((idle_all - prev_idle))
if [ "$diff_total" -le 0 ]; then
    usage=0
else
    usage=$(( (100 * (diff_total - diff_idle)) / diff_total ))
fi

freq=$(cat /sys/devices/system/cpu/cpufreq/policy0/scaling_cur_freq 2>/dev/null || echo 0)
freq_mhz=$((freq / 1000))
printf '{"text": "C %s%%", "tooltip": "Frecuencia CPU: %s MHz"}\n' "$usage" "$freq_mhz"
