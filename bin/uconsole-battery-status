#!/bin/sh

battery=/sys/class/power_supply/axp20x-battery
# Energía útil medida entre 100 % y 1 % en el ciclo del 2026-07-22.
calibrated_full_uwh=30241687
calibrated_empty_pct=1

read_value() {
    if [ -r "$battery/$1" ]; then
        IFS= read -r value < "$battery/$1"
        printf '%s\n' "$value"
    else
        printf '%s\n' "$2"
    fi
}

capacity=$(read_value capacity 0)
status=$(read_value status Unknown)
voltage_uv=$(read_value voltage_now 0)
current_ua=$(read_value current_now 0)
power_uw=$(read_value power_now 0)
energy_now_uwh=$(read_value energy_now 0)
energy_full_uwh=$(read_value energy_full 0)

case "$capacity" in
    ''|*[!0-9]*) capacity=0 ;;
esac
case "$voltage_uv" in
    ''|*[!0-9-]*) voltage_uv=0 ;;
esac
case "$current_ua" in
    ''|*[!0-9-]*) current_ua=0 ;;
esac
case "$power_uw" in
    ''|*[!0-9-]*) power_uw=0 ;;
esac
case "$energy_now_uwh" in
    ''|*[!0-9-]*) energy_now_uwh=0 ;;
esac
case "$energy_full_uwh" in
    ''|*[!0-9-]*) energy_full_uwh=0 ;;
esac

# El driver publica 42,18 Wh de diseño. Para los tiempos usamos los
# 30,24 Wh que el conjunto entregó realmente hasta su límite calibrado.
usable_capacity=$((capacity - calibrated_empty_pct))
[ "$usable_capacity" -lt 0 ] && usable_capacity=0
usable_range=$((100 - calibrated_empty_pct))
energy_full_uwh=$calibrated_full_uwh
energy_now_uwh=$((calibrated_full_uwh * usable_capacity / usable_range))

absolute_current_ua=$current_ua
[ "$absolute_current_ua" -lt 0 ] && absolute_current_ua=$((0 - absolute_current_ua))

# El AXP puede conservar "Charging" después de apagar el LED de carga.
# A 100 % y con 0,1 A o menos, la batería ya está en mantenimiento.
if [ "$status" = Charging ] &&
   [ "$capacity" -ge 100 ] &&
   [ "$absolute_current_ua" -le 100000 ]; then
    status=Full
fi

[ "$power_uw" -lt 0 ] && power_uw=$((0 - power_uw))
voltage_mv=$(((voltage_uv + 500) / 1000))
voltage=$(printf '%d.%03d' $((voltage_mv / 1000)) $((voltage_mv % 1000)))
power_centiwatts=$(((power_uw + 5000) / 10000))
power=$(printf '%d.%02d' $((power_centiwatts / 100)) $((power_centiwatts % 100)))

case "$status" in
    Charging)
        state=Cargando
        short=CHG
        css_class=charging
        ;;
    Discharging)
        state=Descargando
        short=BAT
        css_class=discharging
        ;;
    Full)
        state='Carga completa'
        short=FULL
        css_class=full
        ;;
    'Not charging')
        state='Conectada, sin cargar'
        short=BAT
        css_class=not-charging
        ;;
    *)
        state="$status"
        short=BAT
        css_class=unknown
        ;;
esac

if [ "$capacity" -le 10 ]; then
    css_class=critical
elif [ "$capacity" -le 20 ]; then
    css_class=warning
fi

format_minutes() {
    total=$1
    hours=$((total / 60))
    minutes=$((total % 60))
    if [ "$hours" -gt 0 ]; then
        printf '%s h %02d min' "$hours" "$minutes"
    else
        printf '%s min' "$minutes"
    fi
}

time_label='No disponible'
if [ "$power_uw" -ge 50000 ]; then
    case "$status" in
        Discharging)
            if [ "$energy_now_uwh" -le 0 ] && [ "$energy_full_uwh" -gt 0 ]; then
                energy_now_uwh=$((energy_full_uwh * capacity / 100))
            fi
            if [ "$energy_now_uwh" -gt 0 ]; then
                minutes=$(((energy_now_uwh * 60 + power_uw / 2) / power_uw))
                time_label="$(format_minutes "$minutes") restantes"
            fi
            ;;
        Charging)
            remaining=$((energy_full_uwh - energy_now_uwh))
            # Antes de completar la calibración el contador puede quedarse en
            # 100 %. En ese caso estima lo que falta por el voltaje 1S Li-ion
            # (3,30-4,20 V) y la potencia que realmente entra a la batería.
            if [ "$remaining" -le 0 ] && [ "$energy_full_uwh" -gt 0 ]; then
                voltage_delta=$((4200000 - voltage_uv))
                [ "$voltage_delta" -lt 0 ] && voltage_delta=0
                [ "$voltage_delta" -gt 900000 ] && voltage_delta=900000
                remaining=$((energy_full_uwh * voltage_delta / 900000))
            fi
            if [ "$remaining" -gt 0 ]; then
                minutes=$(((remaining * 60 + power_uw / 2) / power_uw))
                time_label="$(format_minutes "$minutes") para completar"
            else
                time_label='Menos de 10 min para completar'
            fi
            ;;
        Full)
            time_label='Carga completa'
            ;;
    esac
elif [ "$status" = Full ]; then
    time_label='Carga completa'
fi

printf '{"text":"%s %s","tooltip":"Estado: %s\\nVoltaje: %s V\\nFlujo de batería: %s W\\nTiempo estimado: %s","class":"%s"}\n' \
    "$short" "$capacity" "$state" "$voltage" "$power" "$time_label" "$css_class"
