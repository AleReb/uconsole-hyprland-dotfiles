#!/bin/sh

battery=/sys/class/power_supply/axp20x-battery
# Promedio útil de los ciclos completos del 2026-07-22 y 2026-07-27.
calibrated_full_uwh=30171892
calibrated_empty_pct=1

read_value() {
    if [ -r "$battery/$1" ]; then
        IFS= read -r value < "$battery/$1"
        printf '%s\n' "$value"
    else
        printf '%s\n' "$2"
    fi
}

capacity=$(read_value capacity 0)
status=$(read_value status Unknown)
voltage_uv=$(read_value voltage_now 0)
current_ua=$(read_value current_now 0)
power_uw=$(read_value power_now 0)
energy_now_uwh=$(read_value energy_now 0)
energy_full_uwh=$(read_value energy_full 0)

case "$capacity" in
    ''|*[!0-9]*) capacity=0 ;;
esac
sensor_capacity=$capacity
case "$voltage_uv" in
    ''|*[!0-9-]*) voltage_uv=0 ;;
esac
case "$current_ua" in
    ''|*[!0-9-]*) current_ua=0 ;;
esac
case "$power_uw" in
    ''|*[!0-9-]*) power_uw=0 ;;
esac
case "$energy_now_uwh" in
    ''|*[!0-9-]*) energy_now_uwh=0 ;;
esac
case "$energy_full_uwh" in
    ''|*[!0-9-]*) energy_full_uwh=0 ;;
esac

absolute_current_ua=$current_ua
[ "$absolute_current_ua" -lt 0 ] && absolute_current_ua=$((0 - absolute_current_ua))

# El AXP puede conservar "Charging" y publicar un porcentaje incorrecto
# después de apagar el LED. Cerca de 4,2 V y con 0,1 A o menos, la batería
# ya está en mantenimiento.
if [ "$status" = Charging ] &&
   [ "$voltage_uv" -ge 4180000 ] &&
   [ "$absolute_current_ua" -le 100000 ]; then
    status=Full
fi

[ "$power_uw" -lt 0 ] && power_uw=$((0 - power_uw))

# El contador del AXP y la integración entre reinicios pueden desviarse.
# Estimamos el porcentaje solo con voltaje. La curva viene de las descargas
# completas del 2026-07-22 y 2026-07-27 (30,24 y 30,10 Wh).
state_root=${XDG_STATE_HOME:-"$HOME/.local/state"}
estimate_dir="$state_root/uconsole-battery"
voltage_state="$estimate_dir/voltage-estimate.state"
now_epoch=$(date +%s)
previous_epoch=0
previous_status=Unknown
previous_voltage_uv=0
state_valid=0

if [ -r "$voltage_state" ]; then
    if IFS=' ' read -r previous_epoch previous_status previous_voltage_uv \
        < "$voltage_state"; then
        state_valid=1
    fi
fi

case "$previous_epoch" in
    ''|*[!0-9]*) previous_epoch=0; state_valid=0 ;;
esac
case "$previous_voltage_uv" in
    ''|*[!0-9]*) previous_voltage_uv=0; state_valid=0 ;;
esac

smoothed_voltage_uv=$voltage_uv
if [ "$state_valid" -eq 1 ] && [ "$status" = "$previous_status" ]; then
    elapsed=$((now_epoch - previous_epoch))
    if [ "$elapsed" -gt 0 ] && [ "$elapsed" -le 300 ]; then
        # Suavizado corto para que un cambio momentáneo de carga no haga
        # saltar el porcentaje. Solo se conservan muestras de voltaje.
        smoothed_voltage_uv=$(((previous_voltage_uv * 3 + voltage_uv) / 4))
    fi
fi

voltage_capacity() {
    voltage_value=$1
    if [ "$voltage_value" -ge 4050000 ]; then
        printf '100\n'
    elif [ "$voltage_value" -ge 4000000 ]; then
        printf '%s\n' $((96 + (voltage_value - 4000000) * 4 / 50000))
    elif [ "$voltage_value" -ge 3950000 ]; then
        printf '%s\n' $((85 + (voltage_value - 3950000) * 11 / 50000))
    elif [ "$voltage_value" -ge 3900000 ]; then
        printf '%s\n' $((75 + (voltage_value - 3900000) * 10 / 50000))
    elif [ "$voltage_value" -ge 3850000 ]; then
        printf '%s\n' $((59 + (voltage_value - 3850000) * 16 / 50000))
    elif [ "$voltage_value" -ge 3800000 ]; then
        printf '%s\n' $((54 + (voltage_value - 3800000) * 5 / 50000))
    elif [ "$voltage_value" -ge 3750000 ]; then
        printf '%s\n' $((48 + (voltage_value - 3750000) * 6 / 50000))
    elif [ "$voltage_value" -ge 3700000 ]; then
        printf '%s\n' $((42 + (voltage_value - 3700000) * 6 / 50000))
    elif [ "$voltage_value" -ge 3650000 ]; then
        printf '%s\n' $((32 + (voltage_value - 3650000) * 10 / 50000))
    elif [ "$voltage_value" -ge 3600000 ]; then
        printf '%s\n' $((26 + (voltage_value - 3600000) * 6 / 50000))
    elif [ "$voltage_value" -ge 3550000 ]; then
        printf '%s\n' $((24 + (voltage_value - 3550000) * 2 / 50000))
    elif [ "$voltage_value" -ge 3500000 ]; then
        printf '%s\n' $((20 + (voltage_value - 3500000) * 4 / 50000))
    elif [ "$voltage_value" -ge 3450000 ]; then
        printf '%s\n' $((15 + (voltage_value - 3450000) * 5 / 50000))
    elif [ "$voltage_value" -ge 3400000 ]; then
        printf '%s\n' $((10 + (voltage_value - 3400000) * 5 / 50000))
    elif [ "$voltage_value" -ge 3350000 ]; then
        printf '%s\n' $((5 + (voltage_value - 3350000) * 5 / 50000))
    elif [ "$voltage_value" -ge 3300000 ]; then
        printf '%s\n' $((2 + (voltage_value - 3300000) * 3 / 50000))
    else
        printf '%s\n' "$calibrated_empty_pct"
    fi
}

capacity=$(voltage_capacity "$smoothed_voltage_uv")
if [ "$status" = Charging ] && [ "$capacity" -ge 100 ]; then
    # No declarar 100 % mientras todavía entra corriente.
    capacity=99
elif [ "$status" = Full ]; then
    capacity=100
fi

energy_full_uwh=$calibrated_full_uwh
energy_now_uwh=$((energy_full_uwh * capacity / 100))
[ "$capacity" -lt "$calibrated_empty_pct" ] && capacity=$calibrated_empty_pct
[ "$capacity" -gt 100 ] && capacity=100

mkdir -p "$estimate_dir"
voltage_tmp="$voltage_state.$$"
if printf '%s %s %s\n' "$now_epoch" "$status" "$smoothed_voltage_uv" \
    > "$voltage_tmp"; then
    mv -f "$voltage_tmp" "$voltage_state"
fi

voltage_mv=$(((voltage_uv + 500) / 1000))
voltage=$(printf '%d.%03d' $((voltage_mv / 1000)) $((voltage_mv % 1000)))
power_centiwatts=$(((power_uw + 5000) / 10000))
power=$(printf '%d.%02d' $((power_centiwatts / 100)) $((power_centiwatts % 100)))

case "$status" in
    Charging)
        state=Cargando
        short=CHG
        css_class=charging
        ;;
    Discharging)
        state=Descargando
        short=BAT
        css_class=discharging
        ;;
    Full)
        state='Carga completa'
        short=FULL
        css_class=full
        ;;
    'Not charging')
        state='Conectada, sin cargar'
        short=BAT
        css_class=not-charging
        ;;
    *)
        state="$status"
        short=BAT
        css_class=unknown
        ;;
esac

if [ "$capacity" -le 10 ]; then
    css_class=critical
elif [ "$capacity" -le 20 ]; then
    css_class=warning
fi

format_compact_time() {
    total=$1
    printf '%d:%02d' $((total / 60)) $((total % 60))
}

time_compact=
if [ "$power_uw" -ge 50000 ]; then
    case "$status" in
        Discharging)
            if [ "$energy_now_uwh" -le 0 ] && [ "$energy_full_uwh" -gt 0 ]; then
                energy_now_uwh=$((energy_full_uwh * capacity / 100))
            fi
            if [ "$energy_now_uwh" -gt 0 ]; then
                minutes=$(((energy_now_uwh * 60 + power_uw / 2) / power_uw))
                time_compact=$(format_compact_time "$minutes")
            fi
            ;;
        Charging)
            remaining=$((energy_full_uwh - energy_now_uwh))
            if [ "$remaining" -gt 0 ]; then
                minutes=$(((remaining * 60 + power_uw / 2) / power_uw))
                time_compact=$(format_compact_time "$minutes")
            fi
            ;;
    esac
fi

bar_text="$short $capacity"
[ -n "$time_compact" ] || time_compact='--'

printf '{"text":"%s","tooltip":"Estado: %s\\nVoltaje: %s V\\nFlujo de batería: %s W\\nTiempo estimado: %s\\nSensor AXP: %s%%","class":"%s"}\n' \
    "$bar_text" "$state" "$voltage" "$power" "$time_compact" \
    "$sensor_capacity" "$css_class"
