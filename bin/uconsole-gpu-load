#!/bin/sh
stats="/sys/devices/platform/axi/1002000000.v3d/gpu_stats"
state="${XDG_CACHE_HOME:-$HOME/.cache}/uconsole/gpu.stat"
mkdir -p "$(dirname "$state")"

[ -r "$stats" ] || {
    printf '{"text": "G n/a", "tooltip": "Estadisticas GPU no disponibles"}\n'
    exit 0
}

line="$(awk 'NR == 2 { print $2, $4 }' "$stats")"
read -r timestamp runtime <<EOF
$line
EOF
timestamp="${timestamp:-0}"
runtime="${runtime:-0}"

if [ -r "$state" ]; then
    read -r prev_timestamp prev_runtime < "$state" || true
else
    prev_timestamp=$timestamp
    prev_runtime=$runtime
fi

printf '%s %s\n' "$timestamp" "$runtime" > "$state"

dt=$((timestamp - prev_timestamp))
dr=$((runtime - prev_runtime))
if [ "$dt" -le 0 ] || [ "$dr" -lt 0 ]; then
    usage=0
else
    usage=$(( (100 * dr) / dt ))
    [ "$usage" -gt 100 ] && usage=100
fi

printf '{"text": "G %s%%", "tooltip": "Carga GPU: %s%%"}\n' "$usage" "$usage"
