#!/bin/sh
# Limit CPU demand before USB-backed filesystems are checked or mounted.

set -eu

boot_limit_khz=1800000
attempt=0

while [ "$attempt" -lt 100 ]; do
    applied=0
    for policy in /sys/devices/system/cpu/cpufreq/policy*; do
        limit_file="$policy/scaling_max_freq"
        [ -w "$limit_file" ] || continue
        printf '%s\n' "$boot_limit_khz" >"$limit_file"
        applied=1
    done

    if [ "$applied" -eq 1 ]; then
        exit 0
    fi

    attempt=$((attempt + 1))
    sleep 0.05
done

printf '%s\n' 'CPU frequency policy did not become available during early boot.' >&2
exit 1
