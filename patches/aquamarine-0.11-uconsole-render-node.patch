@@ -36,6 +39,34 @@ using namespace Hyprutils::OS;
 // static funcs
 static WP<CBackend> gBackend;

+// EGL_KHR_display_reference asks EGL to track repeated EGLDisplay handles.
+// Mesa/V3D does not expose it here, while the uConsole split-KMS setup creates
+// multiple renderers against the same forced render node. Calling eglTerminate
+// for one renderer would otherwise invalidate every renderer using that
+// EGLDisplay.
+static std::mutex                             gManualEGLDisplayRefsMutex;
+static std::unordered_map<EGLDisplay, size_t> gManualEGLDisplayRefs;
+
+static size_t retainManualEGLDisplayReference(EGLDisplay display) {
+    std::lock_guard<std::mutex> lock(gManualEGLDisplayRefsMutex);
+    return ++gManualEGLDisplayRefs[display];
+}
+
+static bool releaseManualEGLDisplayReference(EGLDisplay display) {
+    std::lock_guard<std::mutex> lock(gManualEGLDisplayRefsMutex);
+    const auto                  it = gManualEGLDisplayRefs.find(display);
+
+    if (it == gManualEGLDisplayRefs.end())
+        return true;
+
+    if (--it->second == 0) {
+        gManualEGLDisplayRefs.erase(it);
+        return true;
+    }
+
+    return false;
+}
